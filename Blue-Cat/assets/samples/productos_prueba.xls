<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Productos de prueba Blue-Cat</title>
  <style>
    table { border-collapse: collapse; font-family: Arial, sans-serif; }
    th { background: #0f766e; color: #fff; font-weight: bold; }
    th, td { border: 1px solid #cbd5e1; padding: 7px 11px; }
    .num { text-align: right; mso-number-format: "0.000"; }
    .code { mso-number-format: "\@"; }
  </style>
</head>
<body>
<table>
  <thead><tr><th>Nombre</th><th>Precio Venta</th><th>Código de Barras</th><th>Cantidad</th><th>Categoría</th></tr></thead>
  <tbody>
    <tr><td>Agua mineral 600 ml</td><td class="num">990</td><td class="code">PRUEBA-0001</td><td class="num">36</td><td>Bebidas</td></tr>
    <tr><td>Bebida cola 1,5 L</td><td class="num">2490</td><td class="code">PRUEBA-0002</td><td class="num">24</td><td>Bebidas</td></tr>
    <tr><td>Jugo naranja 1 L</td><td class="num">1890</td><td class="code">PRUEBA-0003</td><td class="num">18</td><td>Bebidas</td></tr>
    <tr><td>Pan molde blanco 500 g</td><td class="num">2190</td><td class="code">PRUEBA-0004</td><td class="num">15</td><td>Panadería</td></tr>
    <tr><td>Galletas chocolate 120 g</td><td class="num">1290</td><td class="code">PRUEBA-0005</td><td class="num">30</td><td>Snacks</td></tr>
    <tr><td>Papas fritas 150 g</td><td class="num">1990</td><td class="code">PRUEBA-0006</td><td class="num">20</td><td>Snacks</td></tr>
    <tr><td>Leche entera 1 L</td><td class="num">1390</td><td class="code">PRUEBA-0007</td><td class="num">24</td><td>Lácteos</td></tr>
    <tr><td>Yogur natural 125 g</td><td class="num">690</td><td class="code">PRUEBA-0008</td><td class="num">40</td><td>Lácteos</td></tr>
    <tr><td>Arroz grado 2 1 kg</td><td class="num">1790</td><td class="code">PRUEBA-0009</td><td class="num">25</td><td>Abarrotes</td></tr>
    <tr><td>Fideos espagueti 400 g</td><td class="num">1090</td><td class="code">PRUEBA-0010</td><td class="num">32</td><td>Abarrotes</td></tr>
    <tr><td>Atún en agua 170 g</td><td class="num">2290</td><td class="code">PRUEBA-0011</td><td class="num">16</td><td>Conservas</td></tr>
    <tr><td>Detergente líquido 1 L</td><td class="num">3490</td><td class="code">PRUEBA-0012</td><td class="num">12</td><td>Limpieza</td></tr>
  </tbody>
</table>
</body>
</html>
