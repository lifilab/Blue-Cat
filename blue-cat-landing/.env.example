NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMMERCIAL_EMAIL=ventas@tu-dominio.cl
DATABASE_URL=mysql://root@127.0.0.1:3306/blue_cat_commercial
DATABASE_TIMEZONE=local
# Identidad: genere valores aleatorios antes de habilitar el portal.
# IDENTITY_DATA_KEY debe ser exactamente 32 bytes codificados en Base64.
IDENTITY_DATA_KEY=
IDENTITY_HASH_PEPPER=
OUTBOX_WORKER_TOKEN=
CURRENT_TERMS_VERSION=terms-2026-07
CURRENT_PRIVACY_VERSION=privacy-2026-07
CURRENT_MARKETING_CONSENT_VERSION=marketing-2026-07
EMAIL_PROVIDER=console
EMAIL_FROM="Blue Cat <cuentas@tu-dominio.cl>"
RESEND_API_KEY=
# El comercio real permanece bloqueado hasta aprobar contratos y operación.
COMMERCE_ENABLED=false
LEGAL_STATUS=draft
# Se muestra solo después de registrar una solicitud válida.
BANK_TRANSFER_INSTRUCTIONS="Configurar beneficiario, banco, tipo y número de cuenta antes de operar."
PURCHASE_TOKEN_SECRET=
# Si un precio no está definido, la solicitud queda pendiente de cotización y no muestra datos bancarios.
PYME_PRICE_MINOR=
ENTERPRISE_PRICE_MINOR=
COMMERCIAL_CURRENCY=CLP
COMMERCIAL_CURRENCY_DECIMALS=0
NEXT_PUBLIC_COMMERCIAL_CURRENCY_DECIMALS=0
OFFER_VERSION=
OFFER_VALID_DAYS=7
# Ruta absoluta o nombre de subdirectorio seguro dentro de storage/private/.
PAYMENT_EVIDENCE_DIR=payment-evidence
# Bootstrap de operador: definir solo durante el comando y retirarlas después.
OPERATOR_EMAIL=
OPERATOR_NAME=
OPERATOR_PASSWORD=
